{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,loading,error,not-found,default,template,middleware,sitemap,robots,opengraph-image}.{ts,tsx}",
    "src/app/{icon,apple-icon}.png",
    "src/middleware.ts",
    "src/proxy.ts",
    "src/app/api/**/route.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["**/*.test.ts"],
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "dependencies": "error",
    "devDependencies": "warn",
    "unlisted": "error"
  }
}

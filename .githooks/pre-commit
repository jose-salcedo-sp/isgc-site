#!/bin/sh
# Format and lint-fix staged files so verify/ultracite check matches the commit.
set -e
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi

git diff --cached --name-only --diff-filter=ACMR -z |
  xargs -0 npm exec -- ultracite fix --

git diff --cached --name-only --diff-filter=ACMR -z |
  xargs -0 git add --
